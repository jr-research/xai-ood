# Data and heavy artifacts (never tracked, live on the data disk instead)
data/
/data
results/logs/*
!results/logs/.gitkeep
*.pt
*.pth
*.npy
*.npz
*.ckpt
*.parquet
*.h5
*.hdf5
*.feather
*.safetensors
*.faiss
*.index

# Run artifacts are ignored, but their manifests must survive (see note below)
results/runs/**
!results/runs/**/
!results/runs/**/run_metadata.json
!results/runs/.gitkeep

# Notebooks: exploratory only, don't track outputs
.ipynb_checkpoints/
*.nbconvert.ipynb

# Python
__pycache__/
*.pyc
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/
ENV/
environment.local.yml

# Editors / OS
.vscode/
.DS_Store

# Secrets, if any config ever needs one (e.g. an optional wandb key later)
.env
*.secret.yml
results/figures/**
!results/figures/
!results/figures/.gitkeep
